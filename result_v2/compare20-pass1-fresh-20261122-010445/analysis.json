  "recommended_order": [
    {
      "step": 1,
      "change": "Expose verbatim task_goal as a separate Forecaster input and repeat it beside the latest Actor feedback; retain original task/tool identifiers in plans. Generalize irrelevant historical task names in Critic-generated advice as well as state.",
      "target": "Reduce task-object/state/destination substitution without code-based noun replacement or command filtering.",
      "cost": "Same role calls and experience fields."
    },
    {
      "step": 2,
      "change": "Provide Planner and Critic the same operation syntax/preconditions/effects already available to Actor; keep three short Critic reviews, but identify the condition that changed between a failed and successful attempt.",
      "target": "Prevent incorrect cooling/heating procedures and unconditional retry advice.",
      "cost": "Shared prompt source; no extra verification role or model call."
    },
    {
      "step": 3,
      "change": "Preserve Forecaster order in uncapped catalogue injection. Evaluate a stricter state-only cluster membership rule separately.",
      "target": "Prevent insertion order from overriding relevance and reduce mixed-problem clusters.",
      "cost": "No experience-body filtering, no preset categories, no additional LLM aggregation step."
    }
  ],
